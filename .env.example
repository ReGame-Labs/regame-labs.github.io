# The chat widget only renders when both are set. In CI they come from the
# repository variables CHAT_API_URL and TURNSTILE_SITE_KEY.
# For local development, copy to .env.development.local; the site key below is
# Cloudflare's always-pass test key, which matches the Worker's .dev.vars.
VITE_CHAT_API_URL=http://localhost:8787
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The support links (header, hero, footer) only render with the Open Collective
# page's URL; in CI it comes from the repository variable OPENCOLLECTIVE_URL.
VITE_OPENCOLLECTIVE_URL=
